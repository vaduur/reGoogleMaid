<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="com.android.launcher" /><package android:name="com.oplus.appplatform" />
        <package android:name="dev.evoker.homeholdcts" /><package android:name="com.coloros.assistantscreen" />
        <package android:name="com.google.android.googlequicksearchbox" /><package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.dialer" /><package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.chrome" /><package android:name="com.google.android.inputmethod.latin" />
        <package android:name="com.google.android.contacts" /><package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.deskclock" /><package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.gm" /><package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.apps.nbu.files" /><package android:name="com.google.android.keep" />
        <package android:name="com.google.android.apps.magazines" /><package android:name="com.google.android.apps.translate" />
        <package android:name="com.google.ar.lens" /><package android:name="com.kieronquinn.app.smartspacer" />
    </queries>
    <application android:label="re:GoogleMaid" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".DiscoverService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Maintain user-selected native Google Discover integration in stock launcher through locally paired ADB" />
        </service>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".PairReplyReceiver" android:exported="false" />
        <provider android:name=".StatusProvider" android:authorities="dev.local.ace6tdiscover.status"
            android:exported="true" android:permission="android.permission.DUMP" />
        <provider android:name=".DependencyProvider" android:authorities="dev.local.ace6tdiscover.dependencies"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
